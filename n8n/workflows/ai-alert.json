            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load alert": {
      "main": [
        [
          {
            "node": "Build AI alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build AI alert": {
      "main": [
        [
          {
            "node": "Send AI alert (Telegram)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send AI alert (Telegram)": {
      "main": [
        [
          {
            "node": "Mark alert sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
