{
  "id": "uala0aiAlert0000",
  "name": "AI failure alert (Telegram)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "nodes": [
    {
      "id": "f1b2c3d4-5e6f-4a70-8b91-000000000001",
      "name": "Failed message",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "message_id",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "f1b2c3d4-5e6f-4a70-8b91-000000000002",
      "name": "Load alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- AI не ответил на Сообщение, алерт ещё не ушёл, у Заказчика есть группа; иначе 0 строк = стоп.\nselect m.id as message_id, c.name as company_name, c.telegram_chat_id,\n  v.channel, v.sender_id, m.text\nfrom messages m\njoin conversations v on v.id = m.conversation_id and v.company_id = m.company_id\njoin companies c on c.id = m.company_id\nwhere m.id = $1::uuid and m.ai_failed_at is not null and m.ai_alert_sent_at is null\n  and c.telegram_chat_id is not null",
        "options": {
          "queryReplacement": "={{ [$json.message_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "f1b2c3d4-5e6f-4a70-8b91-000000000003",
      "name": "Build AI alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Алерт группе Заказчика: AI не ответил дважды, Клиенту никто не ответил.\nconst alert = $json;\nconst text = [\n  'AI не отвечает — ответьте Клиенту сами',\n  `Заказчик: ${alert.company_name}`,\n  `Клиент: ${alert.channel} ${alert.sender_id}`,\n  `Последнее сообщение: ${alert.text ?? '—'}`,\n].join('\\n');\nreturn { chat_id: alert.telegram_chat_id, text };"
      }
    },
    {
      "id": "f1b2c3d4-5e6f-4a70-8b91-000000000004",
      "name": "Send AI alert (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TELEGRAM_API_BASE_URL }}/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "f1b2c3d4-5e6f-4a70-8b91-000000000005",
      "name": "Mark alert sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Только после успешного sendMessage: ошибка Bot API остановит workflow раньше, retry повторит.\nupdate messages set ai_alert_sent_at = now()\nwhere id = $1::uuid and ai_alert_sent_at is null\nreturning id as message_id, ai_alert_sent_at",
        "options": {
          "queryReplacement": "={{ [$('Load alert').item.json.message_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    }
  ],
  "connections": {
    "Failed message": {
      "main": [
        [
          {
