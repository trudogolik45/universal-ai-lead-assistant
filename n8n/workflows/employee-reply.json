    {
      "id": "8b3f2d10-0000-4000-8000-000000000005",
      "name": "Hand conversation to employee",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Сотрудник ответил в Беседе CRM: активная Беседа Клиента в Канале переходит в режим человека\n-- (Ассистент в ней молчит), Сообщение сотрудника ложится в историю с id записи CRM — retry\n-- не пишет его в CRM второй раз. Повтор того же Сообщения CRM Клиенту не уходит: строки нет.\nwith conversation as (\n  update conversations set status = 'handoff'\n  where id = (select id from conversations\n              where channel = $1 and sender_id = $2 and status in ('open', 'handoff')\n              order by last_message_at desc limit 1)\n    and not exists (select 1 from messages where crm_message_id = $4)\n  returning id, company_id\n),\nmessage as (\n  insert into messages (company_id, conversation_id, direction, text, crm_message_id)\n  select company_id, id, 'out', $3, $4 from conversation\n)\nselect id as conversation_id, $3 as text from conversation",
        "options": {
          "queryReplacement": "={{ [$json.body.channel, $json.body.sender_id, $json.body.text, $json.body.crm_message_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "8b3f2d10-0000-4000-8000-000000000006",
      "name": "Conversation found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ !!$json.conversation_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8b3f2d10-0000-4000-8000-000000000007",
      "name": "Send to client",
      "type": "n8n-nodes-base.executeWorkflow",
