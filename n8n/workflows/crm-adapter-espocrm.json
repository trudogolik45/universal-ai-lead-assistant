              "name": "searchParams",
              "value": "={{ JSON.stringify({ where: [ { type: 'linkedWith', attribute: 'teams', value: [$json.list[0].id] }, { type: 'equals', attribute: 'isActive', value: true } ], select: ['id', 'userName'], orderBy: 'userName', order: 'asc', maxSize: 200 }) }}"
