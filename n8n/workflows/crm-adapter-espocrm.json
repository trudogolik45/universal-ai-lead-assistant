    {
      "id": "c7d2a1e0-0000-4000-8000-000000000107",
      "name": "Team members",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        600
      ],
      "parameters": {
        "jsCode": "// Активные сотрудники группы по одному на элемент; пустая группа — один элемент без сотрудника:\n// задача уйдёт группе без исполнителя.\nconst members = $input.first().json.list.map((user) => ({ json: { user_id: user.id } }));\nreturn members.length ? members : [{ json: { user_id: null } }];"
      }
    },
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000108",
      "name": "Count open tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        600
      ],
      "parameters": {
        "url": "={{ $env.ESPOCRM_BASE_URL }}/api/v1/Task",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "searchParams",
              "value": "={{ JSON.stringify({ where: [ { type: 'equals', attribute: 'assignedUserId', value: $json.user_id }, { type: 'in', attribute: 'status', value: ['Not Started', 'Started'] } ], select: ['id'], maxSize: 1 }) }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.ESPOCRM_API_KEY }}"
