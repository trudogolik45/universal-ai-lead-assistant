{
  "id": "uala0crmAdapter0",
  "name": "CRM adapter (EspoCRM)",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "nodes": [
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000001",
      "name": "CRM operation",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "operation",
              "type": "string"
            },
            {
              "name": "data",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000002",
      "name": "Record message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.operation === 'record_message' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000003",
      "name": "Unknown operation",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        440,
        500
      ],
      "parameters": {
        "errorMessage": "={{ 'Переходник CRM не знает операцию ' + $json.operation }}"
      }
    },
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000004",
      "name": "Find conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "url": "={{ $env.ESPOCRM_BASE_URL }}/api/v1/Conversation",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "searchParams",
              "value": "={{ JSON.stringify({ where: [ { type: 'equals', attribute: 'channel', value: $json.data.channel }, { type: 'equals', attribute: 'senderId', value: $json.data.sender_id } ], select: ['id'], maxSize: 1 }) }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.ESPOCRM_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000005",
      "name": "Conversation exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.total > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000006",
      "name": "Create conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ESPOCRM_BASE_URL }}/api/v1/Conversation",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.ESPOCRM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $('CRM operation').item.json.data.channel + ' · ' + $('CRM operation').item.json.data.sender_id, channel: $('CRM operation').item.json.data.channel, senderId: $('CRM operation').item.json.data.sender_id }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000007",
      "name": "Create message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ESPOCRM_BASE_URL }}/api/v1/Message",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.ESPOCRM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversationId: $json.list ? $json.list[0].id : $json.id, direction: $('CRM operation').item.json.data.direction, author: $('CRM operation').item.json.data.author, text: $('CRM operation').item.json.data.text, providerMessageId: $('CRM operation').item.json.data.provider_message_id || null, sentAt: $('CRM operation').item.json.data.sent_at }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "c7d2a1e0-0000-4000-8000-000000000008",
      "name": "Message recorded",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "crm_message_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "crm_conversation_id",
              "value": "={{ $json.conversationId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "CRM operation": {
      "main": [
        [
          {
            "node": "Record message?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record message?": {
      "main": [
        [
          {
            "node": "Find conversation",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Unknown operation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find conversation": {
      "main": [
        [
          {
            "node": "Conversation exists",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Conversation exists": {
      "main": [
        [
          {
            "node": "Create message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create conversation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create conversation": {
      "main": [
        [
          {
            "node": "Create message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create message": {
      "main": [
        [
          {
            "node": "Message recorded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
