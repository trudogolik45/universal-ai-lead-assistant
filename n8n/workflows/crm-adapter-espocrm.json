      "id": "c7d2a1e0-0022-4000-8000-000000000001",
      "name": "Record lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        1600
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Заявка в виде полей EspoCRM. Имя неизвестно — имя Беседы: без lastName CRM не пишет ни Клиента, ни Заявку.\n// Телефон не в международном формате CRM отвергает (400): такой не пишем, Заявка важнее.\n// В WhatsApp отправитель (wa_id) — номер Клиента без «+»: он телефон, если Клиент не назвал другой.\nconst d = $json.data;\nconst words = (d.name || '').trim().split(/\\s+/).filter(Boolean);\nconst phone = (d.phone || (d.channel === 'whatsapp' ? `+${d.sender_id}` : '')).replace(/[\\s().-]/g, '');\nconst vehicle = [d.vehicle_brand, d.vehicle_model].filter(Boolean).join(' ');\nreturn {\n  json: {\n    person: {\n      firstName: words.slice(0, -1).join(' ') || null,\n      lastName: words.at(-1) || `${d.channel} · ${d.sender_id}`,\n      ...(/^\\+[0-9]{8,15}$/.test(phone) ? { phoneNumber: phone } : {}),\n    },\n    vehicle: vehicle ? { name: vehicle, brand: d.vehicle_brand, model: d.vehicle_model } : null,\n    lead: { service: d.service, description: d.description, desiredTime: d.desired_date },\n  },\n};"
      },
