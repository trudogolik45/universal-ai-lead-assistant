    {
      "id": "c7d2a1e0-0000-4000-8000-000000000102",
      "name": "Task team",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        600
      ],
      "parameters": {
        "jsCode": "// Задача человеку: вид → группа (команда EspoCRM). Команды заводит scripts/espocrm_bootstrap.py,\n// сотрудников в них добавляет Заказчик в админке CRM.\nconst TEAM_BY_KIND = { handoff: 'Administratorzy' };\nconst kind = $('CRM operation').first().json.data.kind;\nif (!TEAM_BY_KIND[kind]) {\n  throw new Error(`Переходник CRM не знает вид Задачи человеку ${kind}`);\n}\nreturn [{ json: { team: TEAM_BY_KIND[kind] } }];"
      }
    },
