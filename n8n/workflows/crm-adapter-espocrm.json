    {
      "id": "c7d2a1e0-0000-4000-8000-000000000109",
      "name": "Least busy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        600
      ],
      "parameters": {
        "jsCode": "// Наименее загруженный: меньше всего открытых задач; при равенстве — первый по имени пользователя.\nconst members = $('Team members').all();\nconst loads = $input.all().map((item) => item.json.total);\nconst index = loads.indexOf(Math.min(...loads));\nreturn [{ json: { assigned_user_id: members[index].json.user_id } }];"
      }
