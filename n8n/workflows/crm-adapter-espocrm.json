    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Заявка в виде полей EspoCRM. Имя неизвестно — имя Беседы: без lastName CRM не пишет ни Клиента, ни Заявку.\n// Телефон не в международном формате CRM отвергает (400): такой не пишем, Заявка важнее.\nconst d = $json.data;\nconst words = (d.name || '').trim().split(/\\s+/).filter(Boolean);\nconst phone = (d.phone || '').replace(/[\\s().-]/g, '');\nconst vehicle = [d.vehicle_brand, d.vehicle_model].filter(Boolean).join(' ');\nreturn {\n  json: {\n    person: {\n      firstName: words.slice(0, -1).join(' ') || null,\n      lastName: words.at(-1) || `${d.channel} · ${d.sender_id}`,\n      ...(/^\\+[0-9]{8,15}$/.test(phone) ? { phoneNumber: phone } : {}),\n    },\n    vehicle: vehicle ? { name: vehicle, brand: d.vehicle_brand, model: d.vehicle_model } : null,\n    lead: { service: d.service, description: d.description, desiredTime: d.desired_date },\n  },\n};"
      },
