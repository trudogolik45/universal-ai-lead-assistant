    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Оценку ремонта просим один раз на Заказ-наряд: мастер закрыл его повторно (переоткрыл и снова закрыл) —\n-- строка уже есть, поток останавливается.\ninsert into repair_ratings (company_id, crm_repair_order_id, conversation_id)\nvalues ($1::uuid, $2, $3::uuid)\non conflict do nothing\nreturning conversation_id",
        "options": {
          "queryReplacement": "={{ [$json.company_id, $('Repair status changed').item.json.body.crm_repair_order_id, $json.conversation_id] }}"
        }
      },
      "id": "9c4e3a20-0000-4000-8000-000000000009",
