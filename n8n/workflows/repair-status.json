    {
      "id": "9c4e3a20-0000-4000-8000-000000000005",
      "name": "Find client conversation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Куда сообщить Клиенту о ремонте: из его Бесед в CRM — та, где он писал последним. Клиент писал\n-- и в Messenger, и в WhatsApp — одно сообщение, а не два. Беседы нет в буфере — сообщать некуда.\nselect v.id as conversation_id, v.company_id, v.channel, co.name as company,\n  coalesce(v.language, co.default_language) as language, $2 as status\nfrom conversations v\njoin jsonb_to_recordset($1::jsonb) as c(channel text, sender_id text)\n  on c.channel = v.channel and c.sender_id = v.sender_id\njoin companies co on co.id = v.company_id\norder by v.last_message_at desc\nlimit 1",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.body.conversations || []), $json.body.status] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "9c4e3a20-0000-4000-8000-000000000006",
      "name": "Status notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "jsCode": "// Клиенту уходят три статуса Заказ-наряда: машину приняли, ждём запчасти, можно забирать.\n// Остальные статусы внутренние. Шаблоны WhatsApp одобрены у Meta на pl и en, без параметров\n// (docs/whatsapp-setup.md), текст SMS — те же два языка.\nconst NOTICES = {\n  'Accepted': {\n    template: 'repair_accepted',\n    pl: 'przyjęliśmy Twój samochód do serwisu.',\n    en: 'we have received your car at the workshop.',\n  },\n  'Waiting for Parts': {\n    template: 'repair_waiting_for_parts',\n    pl: 'czekamy na części do Twojego samochodu. Damy znać, gdy będzie gotowy.',\n    en: 'we are waiting for parts for your car. We will let you know when it is ready.',\n  },\n  'Ready': {\n    template: 'repair_ready',\n    pl: 'Twój samochód jest gotowy do odbioru.',\n    en: 'your car is ready for collection.',\n  },\n};\n\n// Postgres-узел без строк отдаёт один item без полей — Беседы Клиента нет.\nreturn $input.all().filter(({ json: r }) => r.conversation_id && NOTICES[r.status]).map(({ json: r }) => {\n  const notice = NOTICES[r.status];\n  return {\n    json: {\n      conversation_id: r.conversation_id,\n      text: `${r.company}: ${notice[r.language === 'pl' ? 'pl' : 'en']}`,\n      template: { name: notice.template },\n    },\n  };\n});"
      }
    },
