    {
      "parameters": {
        "jsCode": "// Оценка ремонта в одно касание: в WhatsApp — кнопки 1–5 одобренного шаблона (docs/whatsapp-setup.md),\n// Клиенту из Messenger и Instagram — SMS с просьбой ответить цифрой там, где он писал: ответ на SMS\n// до нас не доходит. Языки — pl и en, как у шаблона.\nconst CHANNEL_NAMES = {\n  messenger: { pl: ' na Messengerze', en: ' on Messenger' },\n  instagram: { pl: ' na Instagramie', en: ' on Instagram' },\n};\nconst client = $('Find client conversation').first().json;\nconst language = client.language === 'pl' ? 'pl' : 'en';\nconst where = CHANNEL_NAMES[client.channel]?.[language] ?? '';\nconst REQUEST = {\n  pl: `dziękujemy za wizytę! Jak oceniasz naprawę w skali od 1 do 5? Odpisz jedną cyfrą${where}.`,\n  en: `thank you for your visit! How would you rate the repair from 1 to 5? Reply with one digit${where}.`,\n};\nreturn {\n  json: {\n    conversation_id: $json.conversation_id,\n    text: `${client.company}: ${REQUEST[language]}`,\n    template: { name: 'repair_rating_request' },\n  },\n};"
      },
