    {
      "id": "b9a1c5b0-0d6b-4a43-9a0e-000000000010",
      "name": "Normalize payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// Единая форма входящего Сообщения для всех Каналов:\n// { channel, account_id, sender_id, provider_message_id, text }. Один item на вебхук:\n// дальше все его сообщения ложатся в буфер одной записью.\n// Новый Канал = новая функция здесь (ключ — body.object вебхука), остальной поток не меняется.\nconst body = $input.first().json.body ?? {};\n\n// Messenger и Instagram Direct (Messenger Platform) шлют одну форму: entry[].messaging[].\n// Эхо (is_echo) — сообщение самого Заказчика, не Клиента.\nfunction messaging(channel, body) {\n  const out = [];\n  for (const entry of body.entry ?? []) {\n    for (const event of entry.messaging ?? []) {\n      const message = event.message;\n      if (!message || message.is_echo || typeof message.text !== 'string') continue;\n      out.push({\n        channel,\n        account_id: String(event.recipient.id),\n        sender_id: String(event.sender.id),\n        provider_message_id: message.mid,\n        text: message.text,\n      });\n    }\n  }\n  return out;\n}\n\n// WhatsApp Cloud API: сообщения в entry[].changes[].value.messages, номер Заказчика —\n// metadata.phone_number_id. Статусы доставки (value.statuses) и не текст пропускаем.\nfunction whatsapp(body) {\n  const out = [];\n  for (const entry of body.entry ?? []) {\n    for (const change of entry.changes ?? []) {\n      const value = change.value ?? {};\n      for (const message of value.messages ?? []) {\n        if (message.type !== 'text' || typeof message.text?.body !== 'string') continue;\n        out.push({\n          channel: 'whatsapp',\n          account_id: String(value.metadata.phone_number_id),\n          sender_id: String(message.from),\n          provider_message_id: message.id,\n          text: message.text.body,\n        });\n      }\n    }\n  }\n  return out;\n}\n\nconst NORMALIZERS = {\n  page: (body) => messaging('messenger', body),\n  instagram: (body) => messaging('instagram', body),\n  whatsapp_business_account: whatsapp,\n};\nconst normalize = NORMALIZERS[body.object];\nreturn [{ json: { messages: normalize ? normalize(body) : [] } }];"
      }
    },
    {
      "id": "b9a1c5b0-0d6b-4a43-9a0e-000000000101",
      "name": "Buffer messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Сначала буфер, потом 200: упала запись — Meta получит ошибку и пришлёт вебхук снова.\n-- Дубль по provider_message_id не вставляется и дальше не идёт. Одна строка ответа и при пустом вебхуке.\nwith buffered as (\n  insert into inbox (provider_message_id, message)\n  select m->>'provider_message_id', m from jsonb_array_elements($1::jsonb) m\n  on conflict (provider_message_id) do nothing\n  returning id\n)\nselect coalesce(jsonb_agg(id), '[]') as inbox_ids from buffered",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.messages)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
