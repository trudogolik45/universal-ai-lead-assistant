    {
      "id": "b9a1c5b0-0d6b-4a43-9a0e-000000000006",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        400
      ],
      "parameters": {
        "jsCode": "// X-Hub-Signature-256 = 'sha256=' + HMAC-SHA256(сырое тело, META_APP_SECRET).\n// Только по сырому телу: повторная сериализация JSON меняет байты (\\uXXXX у Meta).\nconst crypto = require('crypto');\nconst item = $input.first();\nconst secret = $env.META_APP_SECRET;\nconst header = String(item.json.headers['x-hub-signature-256'] ?? '');\nlet valid = false;\nif (secret && item.binary?.data) {\n  const raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\n  valid = header.length === expected.length\n    && crypto.timingSafeEqual(Buffer.from(header), Buffer.from(expected));\n}\nreturn [{ json: { valid, body: item.json.body } }];"
      }
    },
    {
      "id": "b9a1c5b0-0d6b-4a43-9a0e-000000000007",
      "name": "Signature valid",
      "type": "n8n-nodes-base.if",
