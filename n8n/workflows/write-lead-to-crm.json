            "data": "={{ { channel: $json.channel, sender_id: $json.sender_id, crm_lead_id: $json.crm_lead_id, crm_vehicle_id: $json.crm_vehicle_id, name: $json.name, phone: $json.phone, vehicle_brand: $json.vehicle_brand, vehicle_model: $json.vehicle_model, service: $json.service, description: $json.description, desired_date: $json.desired_date, crm_meeting_id: $json.crm_meeting_id } }}"
          },
          "matchingColumns": [
            "operation",
            "data"
          ],
          "schema": [
            {
