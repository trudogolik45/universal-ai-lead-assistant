    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Записанная версия Заявки и id в CRM; claimed_at снят: следующее изменение пишется сразу.\nupdate crm_leads set crm_lead_id = $2, crm_vehicle_id = nullif($3, ''), written_at = $4::timestamptz, claimed_at = null\nwhere lead_id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [$('Claim lead').item.json.lead_id, $json.crm_lead_id, $json.crm_vehicle_id || '', $('Claim lead').item.json.version] }}"
        }
      },
