    {
      "id": "c29a0000-0000-4000-8000-000000000007",
      "name": "Claim due reminders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Сроки напоминаний: за 24 часа (с 24 до 2 часов до Записи) и за 2 часа (последние 2 часа).\n-- Время Записи — из CRM (сотрудник мог её перенести), Клиент — из appointments (Запись Ассистента).\n-- Срок, наступивший раньше, чем Клиент записался, не напоминается: записанному за 10 часов\n-- «напоминание за сутки» не нужно. Каждый срок — один раз: строку ставит первый запуск, повтор берёт\n-- только неотправленное, взятое больше 5 минут назад (отправка упала).\nwith planned as (\n  select m->>'crm_meeting_id' as crm_meeting_id, (m->>'starts_at')::timestamp at time zone 'UTC' as starts_at\n  from jsonb_array_elements($1::jsonb) m\n),\ndue as (\n  select a.id as appointment_id, a.created_at, p.starts_at,\n    case when p.starts_at <= now() + interval '2 hours' then '2h' else '24h' end as kind\n  from planned p\n  join appointments a on a.crm_meeting_id = p.crm_meeting_id\n  where p.starts_at > now() and p.starts_at <= now() + interval '24 hours'\n),\nclaimed as (\n  insert into appointment_reminders (appointment_id, kind)\n  select appointment_id, kind from due\n  where created_at < starts_at - case kind when '2h' then interval '2 hours' else interval '24 hours' end\n  on conflict (appointment_id, kind) do update set claimed_at = now()\n  where appointment_reminders.sent_at is null and appointment_reminders.claimed_at < now() - interval '5 minutes'\n  returning appointment_id, kind\n)\nselect c.appointment_id, c.kind, l.conversation_id, co.name as company,\n  coalesce(v.language, co.default_language) as language,\n  to_char(d.starts_at at time zone 'UTC', 'YYYY-MM-DD HH24:MI:SS') as starts_at\nfrom claimed c\njoin due d on d.appointment_id = c.appointment_id\njoin appointments a on a.id = c.appointment_id\njoin leads l on l.id = a.lead_id\njoin conversations v on v.id = l.conversation_id\njoin companies co on co.id = a.company_id",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.appointments)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "c29a0000-0000-4000-8000-000000000008",
      "name": "Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Напоминание на языке Беседы: шаблон WhatsApp «appointment_reminder» одобрен у Meta на pl и en\n// (docs/whatsapp-setup.md, параметры — дата и время), текст SMS — те же два языка.\n// Время Записи — местное время Заказчика.\nconst TEMPLATE = 'appointment_reminder';\nconst TIME_ZONE = 'Europe/Warsaw';\nconst TEXTS = {\n  pl: (company, day, time) => `${company}: przypominamy o wizycie ${day} o godz. ${time}.`,\n  en: (company, day, time) => `${company}: reminder of your appointment on ${day} at ${time}.`,\n};\n\n// Postgres-узел без строк отдаёт один item без полей — напоминать некому.\nreturn $input.all().filter((item) => item.json.appointment_id).map(({ json: r }) => {\n  const start = DateTime.fromSQL(r.starts_at, { zone: 'utc' }).setZone(TIME_ZONE);\n  const day = start.toFormat('dd.MM.yyyy');\n  const time = start.toFormat('HH:mm');\n  const text = TEXTS[r.language === 'pl' ? 'pl' : 'en'](r.company, day, time);\n  return {\n    json: {\n      appointment_id: r.appointment_id,\n      kind: r.kind,\n      conversation_id: r.conversation_id,\n      text,\n      template: { name: TEMPLATE, parameters: [day, time] },\n    },\n  };\n});"
      }
    },
