    {
      "id": "e9a1c5b0-0d6b-4a43-9a0e-000000000007",
      "name": "Find undelivered leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Заявки, не дошедшие до Канала доставки, который есть у Заказчика. Свежие (2 минуты) ещё\n-- доставляет основной поток. Sheets — только qualified и с таблицей, как основной поток.\n-- Telegram: qualified — «Новая заявка» (telegram_sent_at), needs_human — сводка (handoff_sent_at);\n-- отметки проверяет и сам notify-lead.\nwith pending as (\n  select l.id, l.created_at,\n    (l.status = 'qualified' and l.sheets_delivered_at is null and co.sheets_spreadsheet_id is not null)\n      as sheets_pending,\n    (co.telegram_chat_id is not null and case l.status when 'qualified' then l.telegram_sent_at is null\n      else l.handoff_sent_at is null end) as telegram_pending\n  from leads l\n  join companies co on co.id = l.company_id\n  where l.status in ('qualified', 'needs_human') and l.updated_at < now() - interval '2 minutes'\n)\nselect id as lead_id, sheets_pending\nfrom pending\nwhere sheets_pending or telegram_pending\norder by created_at",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "e9a1c5b0-0d6b-4a43-9a0e-000000000008",
      "name": "Sheets pending",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        -200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.sheets_pending }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
