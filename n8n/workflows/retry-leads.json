      "parameters": {
        "operation": "executeQuery",
        "query": "-- Буфер: обработка не дошла до конца (сбой, рестарт n8n). Взятые меньше 5 минут назад\n-- ещё в работе у основного потока или прошлого retry: вызов AI с повторами идёт до двух минут.\nupdate inbox set claimed_at = now()\nwhere processed_at is null and claimed_at < now() - interval '5 minutes'\nreturning id as inbox_id",
        "options": {}
