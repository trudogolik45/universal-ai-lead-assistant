    {
      "id": "e9a1c5b0-0d6b-4a43-9a0e-000000000007",
      "name": "Find undelivered leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Заявки, не дошедшие до Канала доставки, который есть у Заказчика.\n-- Sheets — только с таблицей: deliver-lead без неё каждый раз слал бы CRM-webhook.\n-- Telegram отсекает и сам notify-lead (telegram_sent_at, telegram_chat_id).\nselect l.id as lead_id,\n  (l.sheets_delivered_at is null and co.sheets_spreadsheet_id is not null) as sheets_pending\nfrom leads l\njoin companies co on co.id = l.company_id\nwhere l.status in ('qualified', 'needs_human')\n  and ((l.sheets_delivered_at is null and co.sheets_spreadsheet_id is not null)\n    or (l.telegram_sent_at is null and co.telegram_chat_id is not null))\norder by l.created_at",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "e9a1c5b0-0d6b-4a43-9a0e-000000000008",
      "name": "Sheets pending",
      "type": "n8n-nodes-base.if",
