    {
      "id": "e9a1c5b0-0d6b-4a43-9a0e-000000000011",
      "name": "Close silent conversations",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Беседы без Сообщений 7 дней закрываются вместе с Заявкой.\nwith closed as (\n  update conversations set status = 'closed', updated_at = now()\n  where status in ('open', 'handoff') and last_message_at < now() - interval '7 days'\n  returning id, company_id\n)\nupdate leads l set status = 'closed', updated_at = now()\nfrom closed\nwhere l.conversation_id = closed.id and l.company_id = closed.company_id\nreturning l.id as lead_id, l.conversation_id",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "e9a1c5b0-0d6b-4a43-9a0e-000000000012",
      "name": "Find missed AI alerts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Алерты «AI не отвечает», не дошедшие до разработчиков. Свежие (2 минуты) шлёт основной поток.\nselect id as message_id\nfrom messages\nwhere ai_failed_at < now() - interval '2 minutes' and ai_alert_sent_at is null\norder by ai_failed_at",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
