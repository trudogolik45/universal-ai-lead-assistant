    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Заявки, не дописанные в CRM: запись упала (CRM лежала, сбой n8n) или Заявка изменилась во время записи.\n-- Взятые в работу меньше 5 минут назад ещё пишет основной поток. Заявку без попытки записи\n-- (Ассистент ещё не ответил) в CRM писать нечего.\nselect c.lead_id from crm_leads c\njoin leads l on l.id = c.lead_id\nwhere (c.written_at is null or c.written_at < l.updated_at)\n  and (c.claimed_at is null or c.claimed_at < now() - interval '5 minutes')\norder by l.updated_at\nlimit 200",
        "options": {}
