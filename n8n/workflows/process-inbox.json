        "query": "-- Только после успешного sendMessage: ошибка Bot API — алерт повторит следующая неудача.\nupdate inbox set alert_sent_at = now() where id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [$('Count failed attempt').first().json.inbox_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    }
