    {
      "id": "a991b32f-dc1f-4c38-948a-7f70d76f93fb",
      "name": "Count failed attempt",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Обработка упала (CRM или база лежат): сообщение ждёт retry. Третья неудача подряд — алерт\n-- разработчикам «AI не отвечает», один раз на сообщение: Клиент ждёт ответа.\nupdate inbox i set failures = i.failures + 1\nwhere i.id = $1::uuid\nreturning i.id as inbox_id, i.failures >= 3 and i.alert_sent_at is null as alert_due,\n  i.message->>'channel' as channel, i.message->>'sender_id' as sender_id, i.message->>'text' as text,\n  i.failures,\n  (select c.name from companies c\n   where case i.message->>'channel'\n     when 'messenger' then c.messenger_page_id\n     when 'whatsapp' then c.whatsapp_phone_number_id\n     when 'instagram' then c.instagram_account_id\n   end = i.message->>'account_id') as company_name",
        "options": {
          "queryReplacement": "={{ [$('Load buffered message').first().json.inbox_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "febd0531-9bad-4f17-99f1-3b439e2b3615",
      "name": "Alert due",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "05d27cb8",
              "leftValue": "={{ $json.alert_due === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a4941904-a6c8-4adb-bbaf-554fde61259b",
      "name": "Build processing alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Алерт группе разработчиков: обработка сообщения из буфера падает раз за разом, Клиенту никто не ответил.\n// Заказчик его не видит.\nconst text = [\n  'AI не отвечает',\n  `Заказчик: ${$json.company_name ?? '—'}`,\n  `Клиент: ${$json.channel} ${$json.sender_id}`,\n  `Последнее сообщение: ${$json.text ?? '—'}`,\n  `Обработка упала ${$json.failures} раза подряд, retry повторяет её каждые 5 минут.`,\n].join('\\n');\nreturn { json: { chat_id: $env.ALERT_TELEGRAM_CHAT_ID, text } };"
      }
    },
    {
      "id": "777f7351-56ff-436b-b95d-16729ab3bf56",
      "name": "Send processing alert (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TELEGRAM_API_BASE_URL }}/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "75ce232d-cffc-4c3b-829e-144580fb678f",
      "name": "Mark processing alert sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1540,
        400
