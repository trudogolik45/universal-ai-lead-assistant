    {
      "parameters": {
        "jsCode": "// Период отчёта по Варшаве: дневной — вчера, недельный — прошлая неделя с понедельника по воскресенье.\n// today (YYYY-MM-DD) — ручной запуск как будто в другой день; по расписанию — сегодня.\n// Границы — даты EspoCRM в UTC: с переходом на зимнее время сутки длятся 25 часов.\nconst TIME_ZONE = 'Europe/Warsaw';\nconst ESPO_FORMAT = 'yyyy-MM-dd HH:mm:ss';\nconst DAY_FORMAT = 'dd.MM.yyyy';\nconst { period, today } = $json;\nconst day = today ? DateTime.fromISO(today, { zone: TIME_ZONE }) : DateTime.now().setZone(TIME_ZONE);\nconst weekly = period === 'weekly';\nconst end = weekly ? day.startOf('week') : day.startOf('day');\nconst start = end.minus(weekly ? { weeks: 1 } : { days: 1 });\nconst label = weekly\n  ? `${start.toFormat(DAY_FORMAT)}–${end.minus({ days: 1 }).toFormat(DAY_FORMAT)}`\n  : start.toFormat(DAY_FORMAT);\nreturn {\n  json: { period, label, from: start.toUTC().toFormat(ESPO_FORMAT), to: end.toUTC().toFormat(ESPO_FORMAT) },\n};"
      },
      "id": "c7d2a1e5-0034-4000-8000-000000000012",
      "name": "Report period",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "id": "c7d2a1e5-0034-4000-8000-000000000013",
      "name": "Count in CRM",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "uala0crmAdapter0",
          "mode": "id"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "operation": "report",
            "data": "={{ { from: $json.from, to: $json.to } }}"
          },
          "matchingColumns": [
            "operation",
            "data"
          ],
          "schema": [
            {
              "id": "operation",
              "displayName": "operation",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "data",
              "displayName": "data",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "object",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Письмо владельцу на польском: по строке на Канал и итог. Конверсия — Записи / Заявки периода;\n// Заявок нет — прочерк. «Bez kanału» — записи, которым сотрудник не указал Канал, только если они есть.\nconst TITLES = { daily: 'Raport dzienny', weekly: 'Raport tygodniowy' };\nconst CHANNELS = { messenger: 'Messenger', instagram: 'Instagram', whatsapp: 'WhatsApp', call: 'Telefon' };\nconst { period, label } = $('Report period').first().json;\nconst { channels, total } = $json;\n\nfunction line(name, { leads, appointments }) {\n  const conversion = leads ? `${Math.round((appointments / leads) * 100)}%` : '—';\n  return `${name}: zgłoszenia ${leads}, wizyty ${appointments}, konwersja ${conversion}`;\n}\n\nconst inChannels = Object.values(channels).reduce(\n  (sum, c) => ({ leads: sum.leads + c.leads, appointments: sum.appointments + c.appointments }),\n  { leads: 0, appointments: 0 },\n);\nconst other = { leads: total.leads - inChannels.leads, appointments: total.appointments - inChannels.appointments };\nconst subject = `${TITLES[period]}: ${label}`;\nconst text = [\n  subject,\n  '',\n  ...Object.entries(CHANNELS).map(([key, name]) => line(name, channels[key])),\n  ...(other.leads || other.appointments ? [line('Bez kanału', other)] : []),\n  line('Razem', total),\n  '',\n  'Zgłoszenia i wizyty utworzone w CRM w tym okresie. Konwersja to wizyty podzielone przez zgłoszenia.',\n].join('\\n');\nreturn { json: { subject, text } };"
      },
      "id": "c7d2a1e5-0034-4000-8000-000000000014",
      "name": "Report mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
