    {
      "id": "5e7a1c20-0000-4000-8000-000000000005",
      "name": "Return conversation to assistant",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Сотрудник закрыл Задачу «Передача человеку» в CRM: Беседа снова у Ассистента, Заявка collecting\n-- или qualified по обязательным полям. Чужая Задача или Беседа уже не у человека ничего не меняют.\nwith target as (\n  select l.id as lead_id, v.id as conversation_id,\n    array(select f from unnest(c.required_fields) f where nullif(btrim(to_jsonb(l) ->> f), '') is null) as missing\n  from leads l\n  join companies c on c.id = l.company_id\n  join conversations v on v.id = l.conversation_id and v.company_id = l.company_id\n  where l.handoff_task_id = $1 and v.status = 'handoff'\n),\nconversation as (\n  update conversations v set status = 'open'\n  from target\n  where v.id = target.conversation_id\n  returning v.id\n),\nlead as (\n  update leads l set\n    status = case when cardinality(target.missing) = 0 then 'qualified' else 'collecting' end,\n    missing_fields = target.missing\n  from target\n  where l.id = target.lead_id\n  returning l.id\n)\nselect (select id from conversation) as conversation_id, (select id from lead) as lead_id",
        "options": {
          "queryReplacement": "={{ [$json.body.crm_task_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "uala0postgres001",
          "name": "Supabase"
        }
      }
    }
