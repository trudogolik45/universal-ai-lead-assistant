# Имена переменных всего MVP. Секреты пустые: значения только в .env на VPS
# (~/uala/.env) и в credentials n8n. Все переменные видны нодам n8n как $env.*.

# --- n8n и Caddy ---
N8N_DOMAIN=n8n.n3spark.io
# Ключ шифрования credentials n8n. Потерять = потерять все credentials.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# Пусто = версии по умолчанию из deploy/docker-compose.yml.
N8N_VERSION=
CADDY_VERSION=

# --- EspoCRM ---
ESPOCRM_DOMAIN=crm.n3spark.io
# Пароли генерирует make env-init. Действуют только при первой установке: дальше пароль
# базы живёт в томе Postgres, пароль admin меняется в самой EspoCRM.
ESPOCRM_DB_PASSWORD=
ESPOCRM_ADMIN_PASSWORD=
# Пусто = версии по умолчанию из deploy/docker-compose.yml.
ESPOCRM_VERSION=
POSTGRES_VERSION=
# REST API EspoCRM для n8n: адрес внутри compose-сети и ключ API-пользователя n8n
# (пишет make espocrm-api-user).
ESPOCRM_BASE_URL=http://espocrm
ESPOCRM_API_KEY=
# Секрет хуков модуля Uala в EspoCRM: ответ сотрудника (POST /webhook/employee-reply) и закрытая
# Задача человеку (POST /webhook/task-done) приходят в n8n с ним в X-Uala-Secret
# (workflow employee-reply и task-done сверяют). Генерирует make env-init.
EMPLOYEE_REPLY_SECRET=

# --- Supabase (Postgres) ---
# Строка подключения для scripts/migrate.py, scripts/seed.py и credentials n8n
# (scripts/n8n_credentials.py). TLS по умолчанию, локально — ?sslmode=disable.
DATABASE_URL=

# --- Привязки сид-профилей (scripts/seed.py), необязательно ---
DEMO_MESSENGER_PAGE_ID=
DEMO_WHATSAPP_PHONE_NUMBER_ID=
DEMO_INSTAGRAM_ACCOUNT_ID=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Meta (Messenger, Instagram, WhatsApp) ---
# App secret и verify token общие: все Каналы Meta приходят в один вебхук /webhook/meta.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Токен страницы, связанной с аккаунтом Instagram, с instagram_manage_messages (docs/meta-setup.md).
INSTAGRAM_ACCESS_TOKEN=
# Постоянный токен системного пользователя с whatsapp_business_messaging (docs/whatsapp-setup.md).
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_BASE_URL=https://graph.facebook.com/v24.0

# --- SMSAPI (smsapi.pl): SMS Автоматизаций Клиенту без WhatsApp (из Messenger и Instagram) ---
# Токен OAuth из панели SMSAPI с правом отправки SMS.
SMSAPI_TOKEN=
SMSAPI_BASE_URL=https://api.smsapi.pl
# Поле отправителя, зарегистрированное в панели SMSAPI; пусто — поле по умолчанию аккаунта.
SMSAPI_SENDER=

# --- Telegram: алерт «AI не отвечает» разработчикам (workflow ai-alert) ---
# Заказчик Telegram не получает: Заявки и Задачи человеку — в EspoCRM.
TELEGRAM_BOT_TOKEN=
# Группа разработчиков (id вида -100...), бот в ней участник.
ALERT_TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Retry (workflow retry-leads) ---
# Секрет ручного запуска: POST /webhook/retry с заголовком X-Retry-Secret.
# Пусто = ручной запуск закрыт, работает только расписание (раз в 5 минут).
RETRY_WEBHOOK_SECRET=
# Cron расписания; пусто = */5 * * * * (раз в 5 минут).
RETRY_SCHEDULE_CRON=

# --- Напоминания о Записи (workflow appointment-reminders) ---
# Ручной запуск: POST /webhook/reminders с тем же X-Retry-Secret. Cron; пусто = */5 * * * *.
REMINDER_SCHEDULE_CRON=
