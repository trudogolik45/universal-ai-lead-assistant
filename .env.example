# Имена переменных всего MVP. Секреты пустые: значения только в .env на VPS
# (~/uala/.env) и в credentials n8n. Все переменные видны нодам n8n как $env.*.

# --- n8n и Caddy ---
N8N_DOMAIN=n8n.n3spark.io
# Ключ шифрования credentials n8n. Потерять = потерять все credentials.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# Пусто = версии по умолчанию из deploy/docker-compose.yml.
N8N_VERSION=
CADDY_VERSION=

# --- EspoCRM ---
ESPOCRM_DOMAIN=crm.n3spark.io
# Пароли генерирует make env-init. Действуют только при первой установке: дальше пароль
# базы живёт в томе Postgres, пароль admin меняется в самой EspoCRM.
ESPOCRM_DB_PASSWORD=
ESPOCRM_ADMIN_PASSWORD=
# Пусто = версии по умолчанию из deploy/docker-compose.yml.
ESPOCRM_VERSION=
POSTGRES_VERSION=
# REST API EspoCRM для n8n: адрес внутри compose-сети и ключ API-пользователя n8n
# (пишет make espocrm-api-user).
ESPOCRM_BASE_URL=http://espocrm
ESPOCRM_API_KEY=
# Ответ сотрудника из EspoCRM: хук модуля Uala шлёт его на POST /webhook/employee-reply n8n
# с этим секретом в X-Uala-Secret (workflow employee-reply сверяет). Генерирует make env-init.
EMPLOYEE_REPLY_SECRET=

# --- Supabase (Postgres) ---
# Строка подключения для scripts/migrate.py, scripts/seed.py и credentials n8n
# (scripts/n8n_credentials.py). TLS по умолчанию, локально — ?sslmode=disable.
DATABASE_URL=

# --- Привязки сид-профилей (scripts/seed.py), необязательно ---
DEMO_MESSENGER_PAGE_ID=
DEMO_WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_CHAT_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Meta (Messenger, WhatsApp) ---
# App secret и verify token общие: все Каналы Meta приходят в один вебхук /webhook/meta.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# Постоянный токен системного пользователя с whatsapp_business_messaging (docs/whatsapp-setup.md).
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_BASE_URL=https://graph.facebook.com/v24.0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# secret_token из setWebhook: workflow telegram-callback сверяет его с заголовком
# X-Telegram-Bot-Api-Secret-Token. Символы A-Z a-z 0-9 _ -, до 256.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Retry (workflow retry-leads) ---
# Секрет ручного запуска: POST /webhook/retry с заголовком X-Retry-Secret.
# Пусто = ручной запуск закрыт, работает только расписание (раз в 5 минут).
RETRY_WEBHOOK_SECRET=
# Cron расписания; пусто = */5 * * * * (раз в 5 минут).
RETRY_SCHEDULE_CRON=

# --- Google Sheets (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key из JSON-ключа одной строкой, переводы строк как \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_BASE_URL=https://sheets.googleapis.com
# Токен service account (JWT bearer), aud = GOOGLE_OAUTH_BASE_URL/token.
GOOGLE_OAUTH_BASE_URL=https://oauth2.googleapis.com
